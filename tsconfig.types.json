{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "./dist/types",
        "rootDir": "./source"
    },
    "include": [
        "source/**/*",
        "declarations/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "bench"
    ]
}
