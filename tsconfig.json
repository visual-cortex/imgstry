{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "Bundler",
        "declaration": false,
        "skipLibCheck": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "removeComments": false,
        "preserveConstEnums": false,
        "isolatedModules": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "paths": {
            "~/*": ["./source/*"],
            "test/*": ["./test/*"]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./declarations"
        ],
        "types": ["node", "canvas"]
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}
